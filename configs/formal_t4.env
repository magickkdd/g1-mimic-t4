# 双卡 T4 高利用率档（与 kaggle_blinkmimic_t4_ddp.ipynb 的 PROFILE='high_util' 一致）
# baseline 档：PER_RANK_ENVS=2048 PI=1024 WM=1024 POLICY_HIDDEN=1024,512,256 DISABLE_COMPILE=1 COMPILE_MORE=0
DATA_MODE=full40
PER_RANK_ENVS=4096
PER_RANK_PI_BATCH=2048
PER_RANK_WM_BATCH=2048
POLICY_HIDDEN=2048,1024,512,256
ITERATIONS=3500
DISABLE_COMPILE=0
COMPILE_MORE=1
AMP=fp16
FP16_LOSS_SCALE=256
CKPT_EVERY=500
CKPT_MINUTES=10
MAX_HOURS=8
NCCL_P2P_DISABLE=1
