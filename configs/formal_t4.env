# 双卡 T4 max 档（与 kaggle_blinkmimic_t4_ddp.ipynb 的 PROFILE='max' 一致）
# 降档：PI 3072->2048；仍 OOM 则 ENVS 8192->4096；编译报错则 DISABLE_COMPILE=1
DATA_MODE=full40
PER_RANK_ENVS=8192
PER_RANK_PI_BATCH=3072
PER_RANK_WM_BATCH=2048
POLICY_HIDDEN=2048,1024,512,256
ITERATIONS=3500
DISABLE_COMPILE=0
COMPILE_MORE=1
AMP=fp16
FP16_LOSS_SCALE=256
CKPT_EVERY=500
CKPT_MINUTES=10
MAX_HOURS=8
NCCL_P2P_DISABLE=1
