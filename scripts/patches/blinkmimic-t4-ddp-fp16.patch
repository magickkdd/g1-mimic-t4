+def allreduce_grads(module):
+    """Average gradients across ranks as one flat buffer per module (one NCCL call, not one per tensor)."""
+    if not DIST:
+        return
+    grads = [p.grad for p in module.parameters() if p.grad is not None]
+    if not grads:
+        return
+    flat = torch._utils._flatten_dense_tensors([g.contiguous() for g in grads])
+    torch.distributed.all_reduce(flat, op=torch.distributed.ReduceOp.AVG)
+    for g, new in zip(grads, torch._utils._unflatten_dense_tensors(flat, [g.contiguous() for g in grads])):
+        g.copy_(new)
+
+
+def backward_scaled(loss, module):
+    """Backward with the static fp16 loss scale, average gradients across ranks, then unscale in place."""
+    (loss * LOSS_SCALE).backward()
+    allreduce_grads(module)
+    if LOSS_SCALE != 1.0:
+        for p in module.parameters():
+            if p.grad is not None:
+                p.grad.div_(LOSS_SCALE)
+
+
+def sync_norm_buffers():
+    """Running normalizers and EMA buffers must agree across ranks; pack each dtype into one NCCL call."""
+    if not DIST:
+        return
+    for module in (wm, pi, critic, pi_avg):
+        if module is None:
+            continue
+        bufs = [b for b in module.buffers() if b.device.type == "cuda"]  # AveragedModel.n_averaged stays on CPU
+        for dtype in sorted({b.dtype for b in bufs}, key=str):
+            group = [b for b in bufs if b.dtype == dtype]
+            flat = torch.cat([b.reshape(-1) for b in group])
+            torch.distributed.broadcast(flat, 0)
+            offset = 0
+            for b in group:
+                n = b.numel()
+                b.copy_(flat[offset:offset + n].view_as(b))
+                offset += n
+
